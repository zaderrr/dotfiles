
/* Terminal-minimal rofi theme */
/* Place at ~/.config/rofi/terminal.rasi */
/* Use with: rofi -show drun -theme terminal */

* {
    bg:             #1a1a1a;
    bg-alt:         #1f1f1f;
    fg:             #888888;
    fg-bright:      #cccccc;
    fg-dim:         #444444;
    selected:       #1f1f1f;
    selected-fg:    #ffffff;
    border-col:     #222230;
    separator:      #1a1a22;
    transparent:    #00000000;

    font:           "monospace 12";

    background-color: @transparent;
    text-color:       @fg;
}

window {
    width:            700px;
    background-color: @bg;
    border:           1px;
    border-color:     @border-col;
    border-radius:    0px;
    padding:          0;
}

mainbox {
    background-color: @transparent;
    spacing:          0;
    children:         [ listview, inputbar ];
}

listview {
    background-color: @transparent;
    lines:            8;
    fixed-height:     true;
    padding:          4px 0;
    spacing:          0;
    scrollbar:        false;
    reverse:          true;
}

inputbar {
    background-color: @bg-alt;
    text-color:       @fg-bright;
    padding:          12px 16px;
    spacing:          0;
    border:           1px 0 0 0;
    border-color:     @separator;
    children:         [ entry ];
}

prompt {
    text-color:       @fg-dim;
    background-color: @transparent;
    str:              "> ";
    margin:           0 4px 0 0;
}

entry {
    text-color:       @fg-bright;
    background-color: @transparent;
    placeholder:      "";
    placeholder-color: @fg-dim;
}

element {
    background-color: @transparent;
    text-color:       @fg;
    padding:          8px 16px;
}

element selected {
    background-color: @selected;
    text-color:       @selected-fg;
}

element-text {
    background-color: @transparent;
    text-color:       inherit;
    highlight:        none;
}

element-icon {
    enabled:          false;
}
